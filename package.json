{
  "name": "yandex-lyrics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Полноэкранное караоке-лирика, с использованием внешней библиотеки для подсветки звуков, букв",
  "scripts": {
    "dev": "node ./scripts/dev-build.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run build && node ./scripts/smoke.mjs",
    "format": "prettier --write .",
    "sync": "node ./scripts/sync-addon.mjs",
    "build:sync": "npm run build && npm run sync"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@pulsesync/yamusic-types": "^0.0.5",
    "@types/node": "^25.5.2",
    "esbuild": "^0.28.0",
    "jsdom": "^24.1.3",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.8"
  }
}
